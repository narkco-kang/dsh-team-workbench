  "description": "智能体团队：DSH 网页客户端插件，把具名智能体团队做成全窗口聊天应用（铺满窗口、可收起为右下角胶囊）。每个成员有动态表情头像与一组可回退模型路由，可私聊或在群里让管理员 @ 分活；内置 agency-agents-zh 313 个角色、项目部预设、会话记录检索与共享技能库。",
  "type": "module",
  "main": "./dsh/index.js",
  "exports": {
    ".": "./dsh/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "dsh",
    "lib",
    "src",
    "data",
    "presets",
    "scripts",
